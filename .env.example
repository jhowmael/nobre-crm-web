# Copie para .env.local (cp .env.example .env.local). Arquivos .env* não vão para o Git.

# Endereço da API (nobre-crm-api).
NEXT_PUBLIC_API_URL=http://localhost:3333

# Opcional. Só preencha se a API estiver com API_KEY definida.
# Atenção: variáveis NEXT_PUBLIC_ ficam visíveis no navegador; isso serve apenas para demonstração.
NEXT_PUBLIC_API_KEY=
